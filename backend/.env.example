# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=siargao
DB_PASSWORD=change_me
DB_NAME=siargao_pixel_life

# JWT — use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Optional: npm run db:init creates this admin if all three are set
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
